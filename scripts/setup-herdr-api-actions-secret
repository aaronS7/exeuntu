#!/usr/bin/env bash
# Never echo commands from this script; validation briefly holds the token in
# an environment variable even if the caller invoked Bash with xtrace enabled.
set +x
set -euo pipefail

readonly source_repo="${HERDR_API_SOURCE_REPO:-aaronS7/herdr-api}"
readonly actions_repo="${GITHUB_ACTIONS_REPO:-aaronS7/exeuntu}"
readonly secret_name="${GITHUB_ACTIONS_SECRET_NAME:-HERDR_API_GITHUB_TOKEN}"
readonly expiry_days="${GITHUB_TOKEN_EXPIRY_DAYS:-90}"

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Create a repository-scoped GitHub token for the private Herdr API and save it
as an Actions secret without writing the token to disk.

Usage:
  scripts/setup-herdr-api-actions-secret

Optional environment variables:
  HERDR_API_SOURCE_REPO       Private source repository (aaronS7/herdr-api)
  GITHUB_ACTIONS_REPO         Repository receiving the secret (aaronS7/exeuntu)
  GITHUB_ACTIONS_SECRET_NAME  Actions secret name (HERDR_API_GITHUB_TOKEN)
  GITHUB_TOKEN_EXPIRY_DAYS    Token lifetime from 1 to 366 days (90)
EOF
}

if (( $# > 0 )); then
    if [[ $# == 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
        usage
        exit 0
    fi
    usage >&2
    exit 2
fi

command -v gh >/dev/null 2>&1 || die "GitHub CLI (gh) is required"
command -v git >/dev/null 2>&1 || die "git is required"

repo_pattern='^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'
[[ "$source_repo" =~ $repo_pattern ]] || die "invalid source repository: ${source_repo}"
[[ "$actions_repo" =~ $repo_pattern ]] || die "invalid Actions repository: ${actions_repo}"
[[ "$secret_name" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "invalid Actions secret name: ${secret_name}"
[[ "$expiry_days" =~ ^[0-9]{1,3}$ ]] || die "GITHUB_TOKEN_EXPIRY_DAYS must be a number from 1 to 366"
expiry_value=$((10#$expiry_days))
(( expiry_value >= 1 && expiry_value <= 366 )) || die "GITHUB_TOKEN_EXPIRY_DAYS must be from 1 to 366"

# Ignore ambient token variables here so the credential used to administer the
# destination repository remains the account explicitly configured with `gh`.
gh_cli=(env -u GH_TOKEN -u GITHUB_TOKEN gh)
"${gh_cli[@]}" auth status --hostname github.com >/dev/null 2>&1 ||
    die "authenticate GitHub CLI first with: gh auth login"
"${gh_cli[@]}" api "repos/${actions_repo}/actions/secrets/public-key" --silent >/dev/null ||
    die "the gh account cannot manage Actions secrets for ${actions_repo}"

source_owner="${source_repo%%/*}"
token_url="https://github.com/settings/personal-access-tokens/new?name=exeuntu-herdr-api-actions&description=Read+the+private+Herdr+API+during+exeuntu+image+builds&target_name=${source_owner}&expires_in=${expiry_value}&contents=read"

printf '%s\n' \
    "GitHub requires you to approve personal access token creation in a browser." \
    "The following page is prefilled with read-only Contents access and a ${expiry_value}-day expiry:" \
    "" \
    "${token_url}" \
    "" \
    "On that page:" \
    "  1. Under Repository access, choose Only select repositories." \
    "  2. Select ${source_repo}." \
    "  3. Generate the token and copy it."

if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$token_url" >/dev/null 2>&1 || true
fi

[[ -r /dev/tty && -w /dev/tty ]] ||
    die "run this script in an interactive terminal so the token can be entered securely"

token=''
cleanup() {
    unset token
}
trap cleanup EXIT

printf '\nPaste the new fine-grained token (input is hidden): ' > /dev/tty
if ! IFS= read -r -s token < /dev/tty; then
    printf '\n' > /dev/tty
    die "could not read the token"
fi
printf '\n' > /dev/tty

[[ -n "$token" ]] || die "no token was entered"
[[ "$token" == github_pat_* ]] ||
    die "expected a fine-grained token beginning with github_pat_; the secret was not changed"

printf 'Validating read access to %s...\n' "$source_repo"
if ! HERDR_API_GITHUB_TOKEN="$token" GIT_TERMINAL_PROMPT=0 \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git \
    -c credential.helper= \
    -c 'credential.helper=!f() { printf "%s\n" "username=x-access-token" "password=$HERDR_API_GITHUB_TOKEN"; }; f' \
    ls-remote --exit-code "https://github.com/${source_repo}.git" HEAD >/dev/null 2>&1; then
    die "the token cannot read ${source_repo}; check the selected repository and Contents permission"
fi

printf 'Saving %s in %s...\n' "$secret_name" "$actions_repo"
printf '%s' "$token" | "${gh_cli[@]}" secret set "$secret_name" \
    --app actions \
    --repo "$actions_repo"
unset token

if ! "${gh_cli[@]}" secret list --app actions --repo "$actions_repo" |
    awk -v wanted="$secret_name" '$1 == wanted { found = 1 } END { exit !found }'; then
    die "GitHub accepted the update, but ${secret_name} was not present when secrets were listed"
fi

printf 'Done. %s is configured for GitHub Actions in %s.\n' "$secret_name" "$actions_repo"
